# ====================================
# FICHIER D'ENVIRONNEMENT - .env
# ====================================
# Copier ce fichier en .env et remplir les valeurs

# ====== SERVEUR ======
FLASK_ENV=development
SECRET_KEY=votre_clé_secrète_super_sécurisée_min_32_caractères
DEBUG=False
PORT=5000

# ====== BASE DE DONNÉES ======
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_status_bot
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ====== JWT ======
JWT_SECRET_KEY=votre_jwt_secret_key_min_32_caractères
JWT_ACCESS_TOKEN_EXPIRES=86400

# ====== API WHATSAPP BUSINESS ======
WHATSAPP_API_TOKEN=EAADx3xY1x5xYBAZBxxx...
WHATSAPP_PHONE_NUMBER_ID=102xxx...
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890
