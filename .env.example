# Fichier de configuration d'environnement
# Copiez ce fichier en .env et remplissez les valeurs

# SERVEUR
FLASK_ENV=development
SECRET_KEY=votre_clé_secrète_super_sécurisée
DEBUG=False

# BASE DE DONNÉES
DATABASE_URL=postgresql://username:password@localhost:5432/whatsapp_status_bot
SQLALCHEMY_TRACK_MODIFICATIONS=False

# JWT
JWT_SECRET_KEY=votre_jwt_secret_key
JWT_ACCESS_TOKEN_EXPIRES=86400

# API WHATSAPP BUSINESS
WHATSAPP_API_TOKEN=votre_token_whatsapp_business
WHATSAPP_PHONE_NUMBER_ID=votre_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=votre_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=votre_webhook_token

# PAYPAL
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=votre_paypal_client_id
PAYPAL_CLIENT_SECRET=votre_paypal_client_secret
PAYPAL_RETURN_URL=http://localhost:5000/payment/paypal/success
PAYPAL_CANCEL_URL=http://localhost:5000/payment/paypal/cancel

# ORANGE MONEY RDC (Congo)
ORANGE_MONEY_RDC_API_KEY=votre_orange_money_rdc_api_key
ORANGE_MONEY_RDC_API_URL=https://api.orange.cd/money
ORANGE_MONEY_RDC_MERCHANT_KEY=votre_merchant_key
ORANGE_MONEY_RDC_SANDBOX=true
ORANGE_MONEY_RDC_COUNTRY=CD

# VODACOM RDC (Congo)
VODACOM_RDC_API_KEY=votre_vodacom_rdc_api_key
VODACOM_RDC_API_URL=https://api.vodacom.cd
VODACOM_RDC_MERCHANT_ID=votre_merchant_id
VODACOM_RDC_SANDBOX=true
VODACOM_RDC_COUNTRY=CD

# EMAIL (pour notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_app

# MODES D'ABONNEMENT
FREE_TIER_LIMIT=20
PREMIUM_TIER_LIMIT=unlimited

# LOGGING
LOG_LEVEL=INFO
