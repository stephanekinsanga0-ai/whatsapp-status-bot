# ====== PAYPAL ======
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=AVxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=EHxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_RETURN_URL=http://localhost:5000/payment/paypal/success
PAYPAL_CANCEL_URL=http://localhost:5000/payment/paypal/cancel

# ====== ORANGE MONEY RDC (CONGO) ======
